{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "'B612', sans-serif",
        "$description": "All non-numeric UI: headings, labels, navigation, buttons. Highly legible on dense technical displays."
      },
      "mono": {
        "$value": "'B612 Mono', monospace",
        "$description": "All numeric readouts, timestamps, identifiers, code. Fixed-width prevents value jitter."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "10": { "$value": "10px", "$description": "Micro / uppercase dimension identifiers." },
      "11": { "$value": "11px", "$description": "Captions, helper text." },
      "12": { "$value": "12px", "$description": "Dense UI text." },
      "13": { "$value": "13px", "$description": "Labels, body in panels." },
      "14": { "$value": "14px", "$description": "Body copy." },
      "16": { "$value": "16px", "$description": "Emphasis body / brand mark." },
      "18": { "$value": "18px", "$description": "Heading — medium (uppercase)." },
      "20": { "$value": "20px", "$description": "Heading — medium / value-md." },
      "28": { "$value": "28px", "$description": "Heading — large." },
      "32": { "$value": "32px", "$description": "Value — large." },
      "36": { "$value": "36px", "$description": "Display — small (page title)." },
      "38": { "$value": "38px", "$description": "Readout tile value." },
      "48": { "$value": "48px", "$description": "Value — extra large." },
      "52": { "$value": "52px", "$description": "Display — large hero value." }
    },
    "lineHeight": {
      "$type": "number",
      "none": { "$value": 1 },
      "tight": { "$value": 1.1 },
      "snug": { "$value": 1.2 },
      "normal": { "$value": 1.4 },
      "relaxed": { "$value": 1.5 },
      "loose": { "$value": 1.7 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": "0.02em", "$description": "Base UI tracking." },
      "normal": { "$value": "0.06em", "$description": "Uppercase headings." },
      "label": { "$value": "0.08em", "$description": "Status labels." },
      "wide": { "$value": "0.12em", "$description": "Toggle controls, card titles." },
      "caps": { "$value": "0.15em", "$description": "Badge / button uppercase." },
      "wider": { "$value": "0.2em", "$description": "Brand mark, section accents." },
      "widest": { "$value": "0.3em", "$description": "Section eyebrow labels." }
    }
  }
}
